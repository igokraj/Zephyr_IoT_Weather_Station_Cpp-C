#include <zephyr/dt-bindings/adc/adc.h>


/ {
	aliases {
		status-led = &status_led;
		rain-status = &rain_status;
		rain-vcc = &rain_vcc_pin;
	};

	leds {
		compatible = "gpio-leds";
		status_led: status_led {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};
		rain_vcc_pin: rain_vcc_pin {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "Rain vcc";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		rain_status: rain_status {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Rain status";
		};
};
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO1>,
				 <I2C0_SCL_GPIO2>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";

	htu21d: htu21d@40 {
		compatible = "meas,htu21d";
		reg = <0x40>;
		status = "okay";
	};

	bmp280: bmp280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
		status = "okay";
	};

	max17048: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
		status = "okay";
	};

	bh1750: bh1750@23 {
		compatible = "rohm,bh1750";
		reg = <0x23>;
		status = "okay";
	};
	
};

/ {
	zephyr,user {
		io-channels = <&adc0 3>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};


&wdt0 {
    status = "okay";
};